# --- Database ---------------------------------------------------------------
# Postgres. Local dev: `createdb placeprep && npm run db:migrate`.
# Supabase: Project → Connect → "Session pooler" URI (port 5432), plus ?sslmode=require.
# Use the "Transaction pooler" (port 6543) instead only on serverless hosts.
DATABASE_URL="postgres://localhost:5432/placeprep"
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Admins -----------------------------------------------------------------
# Comma-separated emails that become admins when they sign up or log in.
ADMIN_EMAILS="you@example.com"

# --- Public URL ---------------------------------------------------------------
APP_URL="https://placeprep.me"

# --- Google sign-in (optional; the button only shows when both are set) -----
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Brevo: opted-in students are added to this contact list. Unset = no sync.
BREVO_API_KEY=""
BREVO_LIST_ID=""

# Email verification codes at sign-up (needs Brevo transactional email activated). "on" to enable.
EMAIL_OTP=""
